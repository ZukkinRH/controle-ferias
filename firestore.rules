rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só sessões autenticadas podem ler/escrever — inclusive a sessão
    // anônima que o próprio painel cria automaticamente (sem tela de
    // login do Firebase; a trava por PIN de time é feita no app).
    // Isso não é acesso público: só quem abre o link do painel recebe
    // essa sessão anônima.
    match /colaboradores/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
